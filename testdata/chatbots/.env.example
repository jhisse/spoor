# Copy to .env, fill in what you have, and run a bot with:  uv run --env-file ../.env bot.py
# (or export the variables). Keys stay here: nothing writes them to a file or a trace.

# Where traces go. spoor's default ingest address; this machine may use another port.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Claude: langchain-claude, claude-agent-sdk, plain-anthropic, smolagents-hybrid, litellm-multiprovider
ANTHROPIC_API_KEY=

# OpenAI or any compatible endpoint (OpenRouter, Groq's OpenAI route, a local server...):
# llamaindex-compatible, openai-agents, plain-openai, pydanticai-gemini (fallback), smolagents-hybrid, litellm-multiprovider
OPENAI_API_KEY=
OPENAI_BASE_URL=
# MODEL=gpt-4o-mini

# Gemini: pydanticai-gemini, litellm-multiprovider
GEMINI_API_KEY=

# litellm-multiprovider also reads GROQ_API_KEY, MISTRAL_API_KEY, DEEPSEEK_API_KEY, OPENROUTER_API_KEY
